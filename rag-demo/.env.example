# Copy to .env (gitignored) and uncomment ONE provider block.
# Already-exported shell variables win over this file.
# Check what resolved:  python llm.py

# --- Corpus location (optional)
# Folder of markdown for chunking, Re-index, and the Library page.
# Relative paths are from this rag-demo/ directory, not the shell cwd.
# Unset keeps ./docs. Upload still writes a basename into this folder's
# root; nested *.md files are listed, indexed, and deletable. Restart
# the process and Re-index after changing. index/ stays next to these scripts.
# DOCS_DIR=docs
# DOCS_DIR=/absolute/path/to/markdown

# --- Anthropic (default if LLM_PROVIDER is unset and ANTHROPIC_API_KEY is set)
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-haiku-4-5
# ANTHROPIC_API_KEY=sk-ant-...

# --- OpenAI
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini
# OPENAI_API_KEY=sk-...

# --- Ollama (local). Start the daemon and pull the model first:
#   ollama serve
#   ollama pull llama3.2
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.2
# LLM_BASE_URL=http://127.0.0.1:11434/v1

# --- xAI
# LLM_PROVIDER=xai
# LLM_MODEL=grok-4.5
# XAI_API_KEY=xai-...

# --- Any other OpenAI-compatible endpoint (Groq, OpenRouter, vLLM, LM Studio, …)
# LLM_PROVIDER=openai
# LLM_MODEL=your-model-id
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=...
